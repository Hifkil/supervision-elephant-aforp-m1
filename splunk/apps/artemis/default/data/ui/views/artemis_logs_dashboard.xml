<dashboard version="1.1" theme="dark">
  <label>Artemis Logs</label>
  <description>Vue rapide des logs centralisés dans l'index artemis.</description>

  <row>
    <panel>
      <title>Volume de logs - 24h</title>
      <chart>
        <search>
          <query>index=artemis earliest=-24h@h latest=now | timechart span=15m count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="height">250</option>
      </chart>
    </panel>
    <panel>
      <title>Logs par hôte</title>
      <chart>
        <search>
          <query>index=artemis earliest=-24h@h latest=now | stats count by host | sort - count | head 10</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">none</option>
        <option name="height">250</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Logs par sourcetype</title>
      <chart>
        <search>
          <query>index=artemis earliest=-24h@h latest=now | stats count by sourcetype | sort - count | head 10</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">right</option>
        <option name="height">250</option>
      </chart>
    </panel>
    <panel>
      <title>Derniers événements</title>
      <table>
        <search>
          <query>index=artemis earliest=-24h@h latest=now | sort - _time | head 20 | table _time host source sourcetype _raw</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
        <option name="height">250</option>
      </table>
    </panel>
  </row>
</dashboard>
